# Image tag to run, from the "Fork image" workflow summary (e.g. sha-abc1234).
CAL_TAG=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Public URL the app is served at (used for CORS and password-reset links).
WEB_ORIGIN=https://cal.example.com
# IP of the reverse proxy in front of Cal, so rate limits see real client IPs.
TRUSTED_PROXIES=
# Optional: only clients in these IPs/CIDRs (e.g. LAN + VPN) may use Mail.
# Empty = no restriction.
MAIL_ALLOWED_NETS=
# IANA timezone, e.g. Europe/Berlin
TZ=UTC
# Host port
PORT=8080
